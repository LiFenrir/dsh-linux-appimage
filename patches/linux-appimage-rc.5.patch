new file mode 100644
index 0000000000..c34a7768d4
--- /dev/null
+++ b/apps/desktop/tests/cli-invocation.spec.ts
@@ -0,0 +1,62 @@
+/** Parsed `--dsh-cli` passthrough and the Electron Node-mode child it spawns. */
+
+import { EventEmitter } from 'node:events'
+import { join } from 'node:path'
+import { expect, it, vi } from 'vitest'
+import {
+  DESKTOP_CLI_FLAG, parseDesktopCliInvocation, runDesktopCliInvocation, type DesktopCliSpawn,
+} from '../src/cli-invocation.ts'
+
+const root = join('app', 'resources', 'app.asar', 'dsh')
+const entry = join(root, 'node_modules', '@deepseek-ai', 'dsh-desktop-host', 'lib', 'cli.js')
+
+it('recognizes only the passthrough flag and forwards the arguments after it', () => {
+  expect(parseDesktopCliInvocation(['/app/deepseek-harness', '--no-sandbox'], root)).toBeUndefined()
+  expect(parseDesktopCliInvocation(['/app/deepseek-harness', '--no-sandbox', DESKTOP_CLI_FLAG, 'plugin', '--profile', 'desktop'], root))
+    .toEqual({ entry, args: ['plugin', '--profile', 'desktop'] })
+  expect(parseDesktopCliInvocation([DESKTOP_CLI_FLAG], root)).toEqual({ entry, args: [] })
+})
+
+it('uses the first flag and drops everything before it', () => {
+  expect(parseDesktopCliInvocation([DESKTOP_CLI_FLAG, 'first', DESKTOP_CLI_FLAG, 'second'], root))
+    .toEqual({ entry, args: ['first', DESKTOP_CLI_FLAG, 'second'] })
+})
+
+it('spawns the Electron binary in Node mode with an inherited terminal and returns its exit code', async () => {
+  const child = new EventEmitter()
+  const spawnFn = vi.fn<DesktopCliSpawn>(() => child)
+  const running = runDesktopCliInvocation({ entry, args: ['plugin', 'x y'] }, spawnFn)
+  expect(spawnFn).toHaveBeenCalledExactlyOnceWith(process.execPath,
+    ['--expose-internals', entry, 'plugin', 'x y'],
+    { env: { ...process.env, ELECTRON_RUN_AS_NODE: '1' }, stdio: 'inherit' })
+  child.emit('exit', 7, null)
+  await expect(running).resolves.toBe(7)
+})
+
+it('reports an unknown exit as failure and rejects a spawn that cannot start', async () => {
+  const child = new EventEmitter()
+  const unknown = runDesktopCliInvocation({ entry, args: [] }, () => child)
+  child.emit('exit', null, 'SIGTERM')
+  await expect(unknown).resolves.toBe(1)
+  const failure = new Error('missing binary')
+  const broken = runDesktopCliInvocation({ entry, args: [] }, () => { throw failure })
+  await expect(broken).rejects.toBe(failure)
+})
+
+it('ignores terminal signals while the child runs and restores the previous handlers', async () => {
+  const signals = ['SIGINT', 'SIGTERM', 'SIGHUP'] as const
+  const baseline = signals.map(signal => process.listenerCount(signal))
+  const child = new EventEmitter()
+  const running = runDesktopCliInvocation({ entry, args: [] }, () => child)
+  expect(signals.map(signal => process.listenerCount(signal))).toEqual(baseline.map(count => count + 1))
+  child.emit('exit', 0, null)
+  await expect(running).resolves.toBe(0)
+  expect(signals.map(signal => process.listenerCount(signal))).toEqual(baseline)
+})
+
+it('restores the terminal signal handlers when the child cannot start', async () => {
+  const baseline = process.listenerCount('SIGINT')
+  await expect(runDesktopCliInvocation({ entry, args: [] }, () => { throw new Error('missing binary') }))
+    .rejects.toThrow('missing binary')
+  expect(process.listenerCount('SIGINT')).toBe(baseline)
+})
