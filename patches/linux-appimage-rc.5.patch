diff --git a/apps/desktop/src/command-launcher.ts b/apps/desktop/src/command-launcher.ts
new file mode 100644
index 0000000000..36a51cfd18
--- /dev/null
+++ b/apps/desktop/src/command-launcher.ts
@@ -0,0 +1,34 @@
+/** Generated POSIX launcher for the `dsh` command, independent of an AppImage mount lifetime. */
+
+import { join } from 'node:path'
+
+/**
+ * Resolve the per-user command location on Linux.
+ * @param home - the invoking user's home directory.
+ * @returns `<home>/.local/bin/dsh`, which is on PATH for a conventional Linux login.
+ */
+export function linuxCommandDestination(home: string): string {
+  return join(home, '.local', 'bin', 'dsh')
+}
+
+/**
+ * Build the generated launcher. It starts the application again with `--dsh-cli`, so the
+ * application owns the CLI entry and the command keeps working after an AppImage unmounts.
+ * @param appPath - application executable or AppImage file to start.
+ * @returns POSIX sh script content, executable when written with mode 0755.
+ * @throws Error when the path contains NUL, CR, or LF, which a single-quoted shell word cannot carry.
+ */
+export function linuxCommandLauncher(appPath: string): string {
+  if (/[\0\n\r]/u.test(appPath)) throw new Error('command launcher: the application path contains an unsupported character')
+  return [
+    '#!/bin/sh',
+    '# Generated by DeepSeek Harness. Repair this command from "Manage dsh Command…" in the application.',
+    `exec ${quote(appPath)} --no-sandbox --dsh-cli "$@"`,
+    '',
+  ].join('\n')
+}
+
+/** Wrap one value in a POSIX single-quoted word, closing and reopening around literal single quotes. */
+function quote(value: string): string {
+  return `'${value.replaceAll("'", "'\\''")}'`
+}
