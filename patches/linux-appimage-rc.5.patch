+/** Generated Linux launcher destination and shell quoting. */
+
+import { join } from 'node:path'
+import { expect, it } from 'vitest'
+import { linuxCommandDestination, linuxCommandLauncher } from '../src/command-launcher.ts'
+
+it('installs under the per-user bin directory', () => {
+  expect(linuxCommandDestination('/home/user')).toBe(join('/home/user', '.local', 'bin', 'dsh'))
+})
+
+it('quotes spaces and non-ASCII paths as one shell word', () => {
+  expect(linuxCommandLauncher('/opt/DeepSeek Harness/中文')).toBe([
+    '#!/bin/sh',
+    '# Generated by DeepSeek Harness. Repair this command from "Manage dsh Command…" in the application.',
+    'exec \'/opt/DeepSeek Harness/中文\' --no-sandbox --dsh-cli "$@"',
+    '',
+  ].join('\n'))
+})
+
+it('escapes a literal single quote without ending the quoted word', () => {
+  expect(linuxCommandLauncher("/tmp/it's here/app")).toContain('exec \'/tmp/it\'\\\'\'s here/app\' --no-sandbox --dsh-cli "$@"')
+})
+
+it('rejects paths that a single-quoted shell word cannot carry', () => {
+  expect(() => linuxCommandLauncher('/tmp/a\nb')).toThrow('unsupported character')
+  expect(() => linuxCommandLauncher('/tmp/a\rb')).toThrow('unsupported character')
+  expect(() => linuxCommandLauncher('/tmp/a\0b')).toThrow('unsupported character')
+})
