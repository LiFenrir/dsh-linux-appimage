diff --git a/apps/desktop/src/cli-invocation.ts b/apps/desktop/src/cli-invocation.ts
new file mode 100644
index 0000000000..e38374a44f
--- /dev/null
+++ b/apps/desktop/src/cli-invocation.ts
@@ -0,0 +1,90 @@
+/** Desktop CLI passthrough: an installed wrapper starts the application again with `--dsh-cli`. */
+
+import { spawn } from 'node:child_process'
+import { join } from 'node:path'
+
+/** Argument that switches the desktop application into CLI passthrough instead of opening a window. */
+export const DESKTOP_CLI_FLAG = '--dsh-cli'
+
+/** Terminal signals the child receives directly because it inherits stdio and the process group. */
+const TERMINAL_SIGNALS = ['SIGINT', 'SIGTERM', 'SIGHUP'] as const
+
+/**
+ * Keep the desktop parent alive until the passthrough child handles a terminal signal.
+ * The terminal signals every process in the group; without these handlers Node's default would
+ * terminate the parent first and orphan the child's output.
+ * @returns A disposer that removes only the installed no-op listeners.
+ */
+function ignoreTerminalSignals(): () => void {
+  const ignore = (): void => {}
+  for (const signal of TERMINAL_SIGNALS) process.on(signal, ignore)
+  return () => {
+    for (const signal of TERMINAL_SIGNALS) process.removeListener(signal, ignore)
+  }
+}
+
+/** One parsed passthrough request. */
+export interface DesktopCliInvocation {
+  /** Bundled desktop Host CLI entry inside the application dsh tree. */
+  readonly entry: string
+  /** Arguments after the flag, forwarded unchanged. */
+  readonly args: readonly string[]
+}
+
+/** Child-process events the passthrough observes. */
+export interface DesktopCliProcess {
+  once(event: 'error', listener: (error: Error) => void): unknown
+  once(event: 'exit', listener: (code: number | null, signal: NodeJS.Signals | null) => void): unknown
+}
+
+/** Spawn operation, replaceable for tests. */
+export type DesktopCliSpawn = (
+  command: string,
+  args: readonly string[],
+  options: { readonly env: NodeJS.ProcessEnv; readonly stdio: 'inherit' },
+) => DesktopCliProcess
+
+/**
+ * Find the passthrough flag and the arguments it owns.
+ * @param argv - process argument vector, including the executable path and any launcher flags.
+ * @param dshRoot - application dsh tree (`resources/app.asar/dsh` when packaged).
+ * @returns the CLI entry and forwarded arguments, or undefined for an ordinary window launch.
+ */
+export function parseDesktopCliInvocation(argv: readonly string[], dshRoot: string): DesktopCliInvocation | undefined {
+  const index = argv.indexOf(DESKTOP_CLI_FLAG)
+  if (index < 0) return undefined
+  return {
+    entry: join(dshRoot, 'node_modules', '@deepseek-ai', 'dsh-desktop-host', 'lib', 'cli.js'),
+    args: argv.slice(index + 1),
+  }
+}
+
+/**
+ * Re-run the bundled CLI in Electron Node mode with the current terminal inherited.
+ * @param invocation - parsed entry and forwarded arguments.
+ * @param spawnFn - child-process spawner; defaults to the Node implementation.
+ * @returns the child exit code, with an unknown exit reported as 1.
+ * @throws the spawn failure when the child cannot start.
+ */
+export async function runDesktopCliInvocation(
+  invocation: DesktopCliInvocation,
+  spawnFn: DesktopCliSpawn = spawn,
+): Promise<number> {
+  const restoreSignals = ignoreTerminalSignals()
+  let child: DesktopCliProcess
+  try {
+    child = spawnFn(process.execPath, ['--expose-internals', invocation.entry, ...invocation.args], {
+      env: { ...process.env, ELECTRON_RUN_AS_NODE: '1' },
+      stdio: 'inherit',
+    })
+  }
+  catch (error) {
+    restoreSignals()
+    throw error
+  }
+  return new Promise<number>((resolve, reject) => {
+    // A failed spawn emits both events; the disposer removes listeners it already removed without error.
+    child.once('error', (error) => { restoreSignals(); reject(error) })
+    child.once('exit', (code) => { restoreSignals(); resolve(code ?? 1) })
+  })
+}
